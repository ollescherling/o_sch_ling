-- Kontrollerar dubbelbokningar
SELECT
    A.Rumsnummer,
    A.Bokningsreferens AS Bokning_1,
    B.Bokningsreferens AS Bokning_2
FROM Bokat_rum AS A
JOIN Bokat_rum AS B
    ON A.Rumsnummer = B.Rumsnummer
    AND A.Bokningsreferens < B.Bokningsreferens
JOIN Bokning AS BA
    ON A.Bokningsreferens = BA.Bokningsreferens
JOIN Bokning AS BB
    ON B.Bokningsreferens = BB.Bokningsreferens
WHERE BA.Kund_incheckning_datum < BB.Kund_utcheckning_datum
  AND BA.Kund_utcheckning_datum > BB.Kund_incheckning_datum;

-- Transaktion 8. SELECT. Visa vilka rum som behöver städas.
-- Visar rum där gästen har checkat ut och ingen städning har registrerats efter utcheckningen.
-- Denna transaktion visar alltså inte bara ostädade rum, utan ostädade utcheckade rum.

-- Kontrollerar vilka rum som tillhör bokning B000005,
-- när kunden checkade in och ut samt när rummen senast städades.

SELECT
    Bokning.Bokningsreferens, -- Identifierar bokningen.
    Bokat_rum.Rumsnummer, -- Hämtar rumsnumret som tillhör bokningen.
    Bokning.Faktisk_incheckning, -- Visar faktisk tidpunkt för incheckning.
    Bokning.Faktisk_utcheckning, -- Visar faktisk tidpunkt för utcheckning.
    MAX(Städning.Städat_datum) AS Senaste_städning -- Hämtar senaste registrerade städning för rummet.
FROM Bokning
LEFT JOIN Bokat_rum
    ON Bokning.Bokningsreferens = Bokat_rum.Bokningsreferens -- Kopplar bokningen till dess rum.
LEFT JOIN Städning
    ON Bokat_rum.Rumsnummer = Städning.Rumsnummer -- Kopplar rummet till registrerade städningar.
WHERE Bokning.Bokningsreferens = 'B000005' -- Begränsar resultatet till den valda bokningen.
GROUP BY
    Bokning.Bokningsreferens,
    Bokat_rum.Rumsnummer,
    Bokning.Faktisk_incheckning,Z
    Bokning.Faktisk_utcheckning; -- Grupperar per bokning och rum för att kunna använda MAX().

-- Transaktion 9. SELECT. Visa alla middagsbeställningar.
-- Hämtar middagsbeställningar med information om bokning, 
-- ansvarig kund, antal gäster och eventuell specialkost.

SELECT
	-- Specificerar alla entiteter från middag och kund.
    Middag.Bokningsreferens,
    Kund.Kund_förnamn,
    Kund.Kund_efternamn,
    Middag.Middag_datum,
    Middag.Antal_vuxna,
    Middag.Antal_barn,
    Middag.Specialkost
FROM Middag
-- Mergear via följande nycklar.
-- Bokning är nödvändig för att koppla kund till middag.
JOIN Bokning
    ON Middag.Bokningsreferens = Bokning.Bokningsreferens
JOIN Kund
    ON Bokning.Kundnummer = Kund.Kundnummer
ORDER BY Middag.Middag_datum ASC; -- Sorterar stigande efter middagens datum.

-- Transaktion 10. SELECT. Hämta tidigare kunders mejladresser.
-- Hämtar kunder som har haft minst en bokning med ett passerat utcheckningsdatum.

SELECT DISTINCT
    Kund.Kundnummer,
    Kund.Kund_förnamn,
    Kund.Kund_efternamn,
    Kund.Email
FROM Kund
JOIN Bokning
    ON Kund.Kundnummer = Bokning.Kundnummer
WHERE Bokning.Kund_utcheckning_datum < NOW() -- Undviker att inkludera incheckade kunder.
    AND Kund.Email IS NOT NULL; -- För att undvika krasch måste mail existera.

-- Transaktion 11. SELECT. Visa vilken receptionist som registrerade en specifik bokning.
-- Kopplar bokningen till personalen via Personal_ID. I detta fall bokningen B000005.

SELECT
    Bokning.Bokningsreferens,
    Personal.Personal_ID,Z
    PersZonal.Personal_förnamn,
    Personal.Personal_efternamn,
    Personal.Roll
FROM Bokning
JOIN Personal
    ON Bokning.Personal_ID = Personal.Personal_ID
WHERE Bokning.Bokningsreferens = 'B000005';

-- Transaktion 12. SELECT. Visa vilka rumstyper som bokas mest.
-- Räknar antalet bokningar per rumstyp och sorterar efter popularitet.

SELECT
    Rum.Rumstyp,
    COUNT(Bokat_rum.Rumsnummer) AS Antal_bokningar -- Skapar en temporär variabel som antal bokade rumsnummer.
FROM Rum
JOIN Bokat_rum
    ON Rum.Rumsnummer = Bokat_rum.Rumsnummer
GROUP BY Rum.Rumstyp -- Sorterar dessa efter rumstyp.
ORDER BY Antal_bokningar DESC;
