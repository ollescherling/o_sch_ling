-- Tabellerna skapas i en ordning där refererade tabeller
-- existerar innan tabeller med främmande nycklar skapas.

-- 1. KUND
CREATE TABLE Kund (
    Kundnummer INT PRIMARY KEY, -- Unikt numeriskt ID för varje kund.
    PassPnr VARCHAR(30) UNIQUE, -- Passnummer och personnummer måste hållas unika för att insert bara ska kunna ha en rad per kund.
    Kund_förnamn VARCHAR(50) NOT NULL, -- Textvariabel för kundens förnamn.
    Kund_efternamn VARCHAR(50) NOT NULL, -- Textvariabel för kundens efternamn.
    Email VARCHAR(254), -- Textvariabel som kan innehålla bokstäver, siffror och specialtecken.
    Telefonnummer VARCHAR(20) -- String eftersom telefonnummer kan innehålla landskod och inledande nollor.
);

-- 2. PERSONAL
CREATE TABLE Personal (
    Personal_ID VARCHAR(20) PRIMARY KEY, -- Unikt ID för personalen som kan innehålla både bokstäver och siffror.
    Personal_förnamn VARCHAR(50) NOT NULL, -- Textvariabel för personalens förnamn.
    Personal_efternamn VARCHAR(50) NOT NULL, -- Textvariabel för personalens efternamn.
    Roll VARCHAR(20) NOT NULL -- Textvariabel som beskriver personalens yrkesroll.
);

-- 3. RUM
CREATE TABLE Rum (
    Rumsnummer INT PRIMARY KEY, -- Unikt numeriskt rumsnummer.
    Rumstyp VARCHAR(20) NOT NULL -- Textvariabel som beskriver rumstypen.
);

-- Incheckningsdatum och utcheckningsdatum har tagits bort.
-- Ett rum kan användas för flera bokningar över tid.
-- Dessa datum hör därför till bokningen.

-- 4. BOKNING
CREATE TABLE Bokning (
    Bokningsreferens VARCHAR(20) PRIMARY KEY, -- Kan innehålla text och inte bara siffror, därmed string.
    Kundnummer INT NOT NULL, -- Numeriskt ID för kunden som ansvarar för bokningen.
    Kund_incheckning_datum DATETIME NOT NULL, -- Datum och tid för incheckning.
    Kund_utcheckning_datum DATETIME NOT NULL, -- Datum och tid för utcheckning.
    Personal_ID VARCHAR(20), -- Identifierar personalen som ansvarar för bokningen.
    Pris DECIMAL(12,2) NOT NULL, -- Exakt numeriskt belopp med två decimaler.
	Faktisk_incheckning DATETIME DEFAULT NULL, -- NULL innebär att kunden ännu inte har checkat in.
    Faktisk_utcheckning DATETIME DEFAULT NULL, -- NULL innebär att kunden ännu inte har checkat ut.
    FOREIGN KEY (Kundnummer) REFERENCES Kund(Kundnummer),
    FOREIGN KEY (Personal_ID) REFERENCES Personal(Personal_ID),

    CHECK (Kund_utcheckning_datum > Kund_incheckning_datum),
    CHECK (Pris >= 0)
);

-- 5. BOKAT_RUM. Den här är tom för att inget ska vara bokat i början.
CREATE TABLE Bokat_rum (
    Bokningsreferens VARCHAR(20), -- Kan innehålla text och inte bara siffror, därmed string.
    Rumsnummer INT, -- Numeriskt rumsnummer.
    PRIMARY KEY (Bokningsreferens, Rumsnummer), -- Sammansatt primärnyckel för att identifiera varje bokat rum inom en bokning.
    FOREIGN KEY (Bokningsreferens) REFERENCES Bokning(Bokningsreferens),
    FOREIGN KEY (Rumsnummer) REFERENCES Rum(Rumsnummer)
);

-- 6. GRUPP
CREATE TABLE Grupp (
    Kundnummer INT, -- Numeriskt ID för kunden som ingår i gruppbokningen.
    Bokningsreferens VARCHAR(20), -- Identifierar bokningen som kunden tillhör.
    PRIMARY KEY (Kundnummer, Bokningsreferens), -- Sammansatt primärnyckel för att identifiera kunden inom en bokning.
    FOREIGN KEY (Kundnummer) REFERENCES Kund(Kundnummer),
    FOREIGN KEY (Bokningsreferens) REFERENCES Bokning(Bokningsreferens)
);

-- Gruppbokning BOOLEAN har tagits bort.
-- Tabellen representerar nu vilka kunder som ingår i en bokning.
-- Om en bokning har flera registrerade kunder kan den användas
-- för att identifiera en gruppbokning.

-- 7. ERBJUDANDE
CREATE TABLE Erbjudande (
    Kundnummer INT, -- Numeriskt ID för kunden som får erbjudandet.
    Erbjudande_kod INT, -- Numerisk kod som identifierar erbjudandet.

    PRIMARY KEY (Kundnummer, Erbjudande_kod), -- Sammansatt primärnyckel som tillåter flera erbjudanden per kund.

    FOREIGN KEY (Kundnummer) REFERENCES Kund(Kundnummer)
);

-- Email har tagits bort eftersom adressen redan finns i Kund.
-- Kundnummer används för att identifiera mottagaren.

-- 8. BETALNING
CREATE TABLE Betalning (
    Betalning_ID INT AUTO_INCREMENT PRIMARY KEY, -- Unikt numeriskt ID för varje betalning.
    Bokningsreferens VARCHAR(20) NOT NULL, -- Identifierar bokningen som betalningen tillhör.
    Betalningsmetod VARCHAR(20) NOT NULL, -- Betalningsmetod, exempelvis Swish, Kort eller Kontant.
    Belopp DECIMAL(12,2) NOT NULL, -- Exakt numeriskt betalningsbelopp med två decimaler.
    Valuta CHAR(3) NOT NULL DEFAULT 'SEK', -- Valutakod med tre bokstäver, exempelvis SEK, USD, EUR eller GBP.
    Betalningsdatum DATETIME NOT NULL, -- Datum och tid för betalningen.

    FOREIGN KEY (Bokningsreferens) REFERENCES Bokning(Bokningsreferens),

    CHECK (Belopp >= 0), -- Belopp på 0 tillåts om en kund får en vistelse gratis.
	CHECK(Belopp <= 100000), -- Betalningar får ett tak på 100,000 SEK om någon av misstag lägger på två extra nollor.
    CHECK (Betalningsmetod IN ('Swish', 'Kort', 'Kontant')) -- Tillåter bara tre betaltyper.
);

-- Faktura är en faktureringsmetod, inte en genomförd betalning.
-- För ett mer avancerat system bör fakturor lagras separat.
-- Återbetalningar behöver också en separat hantering.

-- 9. MIDDAG
CREATE TABLE Middag (
    Bokningsreferens VARCHAR(20), -- Identifierar bokningen som middagen tillhör.
    Middag_datum DATETIME, -- Datum och tid för middagen.

    -- Numeriska variabler med standardvärde 0 om inget annat anges.
    Antal_vuxna INT NOT NULL DEFAULT 0, -- Integer på grund av numeriskt antal.
    Antal_barn INT NOT NULL DEFAULT 0, -- Integer på grund av numeriskt antal.
    Specialkost VARCHAR(100) DEFAULT 'Inga allergier', -- Textvariabel som anger eventuell specialkost.

    PRIMARY KEY (Bokningsreferens, Middag_datum), -- Sammansatt primärnyckel som tillåter flera middagar per bokning vid olika tidpunkter.

    FOREIGN KEY (Bokningsreferens) REFERENCES Bokning(Bokningsreferens),

    -- Tvingar antalet gäster att vara minst 1 i varje middagsbokning.
    CHECK (Antal_vuxna >= 0),
    CHECK (Antal_barn >= 0),
    CHECK (Antal_vuxna + Antal_barn > 0)
);

-- 10. STÄDNING
CREATE TABLE Städning (
    Rumsnummer INT, -- Identifierar rummet som städats.
    Städat_datum DATETIME, -- Datum och tid för städningen.
    Personal_ID VARCHAR(20) NOT NULL, -- Identifierar personalen som utfört städningen.

    PRIMARY KEY (Rumsnummer, Städat_datum), -- Sammansatt primärnyckel för varje städning av ett rum vid en viss tidpunkt.

    FOREIGN KEY (Rumsnummer) REFERENCES Rum(Rumsnummer),
    FOREIGN KEY (Personal_ID) REFERENCES Personal(Personal_ID)
);

