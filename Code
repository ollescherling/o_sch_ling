-- Transaktion 1. INSERT. Funktion för att registrera ny kund.
-- PK: Kundnummer (högsta befintliga kundnummer + 1).
-- FK: Inga främmande nycklar.
-- PassPnr måste vara unikt.
DROP PROCEDURE IF EXISTS RegistreraKund; -- Drop procedure som if för att det inte ska krascha om det körs igen.
-- Delimiter för funktionens början.
DELIMITER //
CREATE PROCEDURE RegistreraKund(
    IN p_PassPnr VARCHAR(30),
    IN p_Förnamn VARCHAR(50),
    IN p_Efternamn VARCHAR(50),
    IN p_Email VARCHAR(100),
    IN p_Telefonnummer VARCHAR(20)
)
BEGIN
    INSERT IGNORE INTO Kund
        (Kundnummer, PassPnr, Kund_förnamn, Kund_efternamn, Email, Telefonnummer)
    SELECT
        COALESCE(MAX(Kundnummer), 0) + 1, -- Skapar ett nytt kundnummer genom att addera det högsta existerande med 1.
        p_PassPnr,
        p_Förnamn,
        p_Efternamn,
        p_Email,
        p_Telefonnummer
    FROM Kund;
    -- Visar kunderna efter registreringen.
    SELECT * FROM Kund;
END //
 -- Delimiter för funktionens slut .
