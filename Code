USE HotellHedvig;
-- Raderar funktionen med DROP PROCEDURE om den redan existerar för att det 
-- inte ska krascha vid flera körningar.
DROP PROCEDURE IF EXISTS TilldelaRum;
-- En avgränsare för att sedan köras hela vägen tills nästa delimiter, 
-  för att kunna tolka in en hel funktion.
DELIMITER //
-- Skapar en funktion för att tilldela rum.
CREATE PROCEDURE TilldelaRum(
    IN p_Bokningsreferens VARCHAR(20), -- Arbiträr bokningsreferens.
    IN p_Antal_Enkelrum INT, -- Antal enkelrum som ska bokas.
    IN p_Antal_Familjerum INT -- Antal familjerum som ska bokas.
)
BEGIN
	DECLARE v_Last_bokning VARCHAR(20); -- Lagrar bokningsreferensen vid låsning.
    DECLARE v_Antal INT DEFAULT 0; -- Räknar antalet tilldelade rum.
    DECLARE v_Rumsnummer INT; -- Lagrar ett slumpmässigt valt rum.
    DECLARE v_Rumstyp VARCHAR(20); -- Rumstyp som behandlas.
    DECLARE v_Önskat_antal INT; -- Antal rum som efterfrågas.
    DECLARE v_Typ INT DEFAULT 1; -- Växlar mellan enkelrum och familjerum.
    DECLARE v_Lediga INT; -- Antal tillgängliga rum.
    -- Kontrollerar att bokningsreferensen existerar.
    IF NOT EXISTS (
        SELECT 1 FROM Bokning -- Söker efter en befintlig bokning.
        WHERE Bokningsreferens = p_Bokningsreferens -- Matchar angiven referens.
    ) THEN
        SIGNAL SQLSTATE '45000' -- Avbryter om bokningen saknas.
        SET MESSAGE_TEXT = 'Bokningsreferensen finns inte';
    END IF;
    -- NULL behandlas som 0, så att en rumstyp kan utelämnas.
    SET p_Antal_Enkelrum = COALESCE(p_Antal_Enkelrum, 0);
    SET p_Antal_Familjerum = COALESCE(p_Antal_Familjerum, 0);
    -- Förhindrar negativa antal och bokningar utan rum.
    IF p_Antal_Enkelrum < 0 OR p_Antal_Familjerum < 0
       OR p_Antal_Enkelrum + p_Antal_Familjerum = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Ogiltigt antal rum';Z
    END IF;
    -- Låser bokningen under tilldelningen.
    START TRANSACTION;
	SELECT Bokningsreferens INTO v_Last_bokning
	FROM Bokning
	WHERE Bokningsreferens = p_Bokningsreferens
	FOR UPDATE;
    -- Behandlar först enkelrum och sedan familjerum.
    WHILE v_Typ <= 2 DO
        IF v_Typ = 1 THEN
            SET v_Rumstyp = 'Enkelrum';
            SET v_Önskat_antal = p_Antal_Enkelrum;
        ELSE
            SET v_Rumstyp = 'Familjerum';
            SET v_Önskat_antal = p_Antal_Familjerum;
        END IF;
        -- Om antal är 0 hoppas denna rumstyp över.
        IF v_Önskat_antal > 0 THEN
            -- Räknar hur många rum av vald typ som är lediga.
            SELECT COUNT(*) INTO v_Lediga
            FROM Rum
            JOIN Bokning ON Bokning.Bokningsreferens = p_Bokningsreferens
            WHERE Rum.Rumstyp = v_Rumstyp
              AND NOT EXISTS ( -- Kontrollerar överlappande bokningsperioder.
                  SELECT 1 FROM Bokat_rum
                  JOIN Bokning AS Befintlig_bokning -- Hämtar bokningens datum.
                      ON Bokat_rum.Bokningsreferens = Befintlig_bokning.Bokningsreferens
                  WHERE Bokat_rum.Rumsnummer = Rum.Rumsnummer -- Samma rum.
                    -- Kontrollerar om ett rum redan är bokat vid specifika datum.
                    AND Befintlig_bokning.Kund_incheckning_datum
                        < Bokning.Kund_utcheckning_datum -- Överlappningens början.
                    AND Befintlig_bokning.Kund_utcheckning_datum
                        > Bokning.Kund_incheckning_datum -- Överlappningens slut.
              );
            -- Avbryter om det inte finns tillräckligt många rum.
            IF v_Lediga < v_Önskat_antal THEN
                ROLLBACK; -- Ångrar samtliga rumstilldelningar i anropet.
                SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Fullbokat';
            END IF;
            SET v_Antal = 0; -- Nollställer räknaren för rumstypen.
            WHILE v_Antal < v_Önskat_antal DO -- Loopar och bokar ett rum i taget.
                -- Registrerar ett slumpmässigt ledigt rum för en mer tidseffektiv bokning.
                INSERT INTO Bokat_rum (Bokningsreferens, Rumsnummer)
                SELECT Bokning.Bokningsreferens, Rum.Rumsnummer -- Hämtar två nycklar.
                FROM Bokning -- Extraheras från alla befintliga bokningar.
                JOIN Rum ON Rum.Rumstyp = v_Rumstyp -- Väljer önskad rumstyp.
                WHERE Bokning.Bokningsreferens = p_Bokningsreferens -- Väljer bokningen.
				  -- Utesluter rum som redan tillhör samma bokning. Om ett rum redan tillhör samma bokning körs det igen.
                  AND NOT EXISTS (
                      SELECT 1 FROM Bokat_rum AS Redan_bokat
                      WHERE Redan_bokat.Bokningsreferens = p_Bokningsreferens
                        AND Redan_bokat.Rumsnummer = Rum.Rumsnummer
                  )
                  AND NOT EXISTS ( -- Kontrollerar överlappande bokningsperioder.
                      SELECT 1 FROM Bokat_rum
                      JOIN Bokning AS Befintlig_bokning -- Hämtar bokningens datum.
                          ON Bokat_rum.Bokningsreferens = Befintlig_bokning.Bokningsreferens
                      WHERE Bokat_rum.Rumsnummer = Rum.Rumsnummer -- Samma rum.
                        AND Befintlig_bokning.Kund_incheckning_datum
                            < Bokning.Kund_utcheckning_datum -- Överlappningens början.
                        AND Befintlig_bokning.Kund_utcheckning_datum
                            > Bokning.Kund_incheckning_datum -- Överlappningens slut.
                  )
                ORDER BY RAND() -- Slumpmässigt ledigt rum.
                LIMIT 1; -- Tilldelar högst ett rum per iteration.
                SET v_Antal = v_Antal + 1; -- Ökar räknaren med ett.
            END WHILE;
        END IF;
        SET v_Typ = v_Typ + 1; -- Fortsätter till nästa rumstyp.
    END WHILE;

    COMMIT; -- Sparar samtliga rumstilldelningar.
    SELECT 'Bokning genomförd' AS Status; -- Ett eller flera rum tilldelades.
    SELECT * FROM Bokat_rum
    WHERE Bokningsreferens = p_Bokningsreferens; -- Visar bokade rum.
END //
-- Återställer den vanliga avgränsaren.
DELIMITER ;

-- Bokningsreferens, antalet enkelrum, antal familerum.
CALL TilldelaRum('B000002', 2, 1);
CALL TilldelaRum('B000003', 1, 1);
CALL TilldelaRum('B000003', 1, 0);
CALL TilldelaRum('B000005', 1, 0);

SELECT * FROM Bokat_rum;


-- Transaktion 5. INSERT. Checka in kund.
-- PK: Bokningsreferens och Rumsnummer (sammansatt primärnyckel).
-- FK: Bokningsreferens refererar till Bokning(Bokningsreferens).
-- FK: Rumsnummer refererar till Rum(Rumsnummer).

UPDATE Bokning
SET Faktisk_incheckning = NOW() - INTERVAL 2 DAY -- Registrerar incheckning två dagar tidigare.
WHERE Bokningsreferens = 'B000005'
  AND Faktisk_incheckning IS NULL;

-- Kontrollerar att kunden har checkat in.
SELECT Bokningsreferens, Kundnummer,
       Kund_incheckning_datum, Faktisk_incheckning
FROM Bokning
WHERE Bokningsreferens = 'B000005';

-- Transaktion 6. UPDATE. Checka ut kund.
-- PK: Bokningsreferens.
-- FK: Inga nya främmande nycklar.

UPDATE Bokning
SET Faktisk_utcheckning = NOW() -- Registrerar aktuellt datum och tid.
WHERE Bokningsreferens = 'B000005' -- Identifierar bokningen.
  AND Faktisk_incheckning IS NOT NULL -- Kontrollerar att kunden har checkat in.
  AND Faktisk_utcheckning IS NULL; -- Förhindrar att utcheckningen skrivs över.

-- Kontrollerar att kunden har checkat ut.
SELECT Bokningsreferens, Kundnummer,
       Kund_utcheckning_datum, Faktisk_utcheckning
FROM Bokning
WHERE Bokningsreferens = 'B000005';
SELECT * FROM Bokning;

-- Transaktion 7. UPDATE. Uppdatera en befintlig bokning.
-- PK: Bokningsreferens.
-- FK: Kundnummer refererar till Kund(Kundnummer).
-- FK: Personal_ID refererar till Personal(Personal_ID).

DROP PROCEDURE IF EXISTS UppdateraBokning;

DELIMITER //

CREATE PROCEDURE UppdateraBokning(
    IN p_Bokningsreferens VARCHAR(20), -- Identifierar bokningen.
    IN p_Kundnummer INT, -- Nytt kundnummer.
    IN p_Pris DECIMAL(12,2), -- Nytt pris.
    IN p_Incheckning DATETIME, -- Nytt planerat incheckningsdatum.
    IN p_Utcheckning DATETIME, -- Nytt planerat utcheckningsdatum.
    IN p_Personal_ID VARCHAR(20) -- Ny ansvarig personal.
)
BEGIN
    -- Kontrollerar att bokningen existerar.
    IF NOT EXISTS (
        SELECT 1 FROM Bokning
        WHERE Bokningsreferens = p_Bokningsreferens
    ) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Bokningsreferensen finns inte';
    END IF;

    -- Uppdaterar endast de värden som anges.
    UPDATE Bokning
    SET Kundnummer = COALESCE(p_Kundnummer, Kundnummer),
        Pris = COALESCE(p_Pris, Pris),
        Kund_incheckning_datum = COALESCE(p_Incheckning, Kund_incheckning_datum),
        Kund_utcheckning_datum = COALESCE(p_Utcheckning, Kund_utcheckning_datum),
        Personal_ID = COALESCE(p_Personal_ID, Personal_ID)
    WHERE Bokningsreferens = p_Bokningsreferens;

    -- Visar den uppdaterade bokningen.
    SELECT * FROM Bokning
    WHERE Bokningsreferens = p_Bokningsreferens;
END //

DELIMITER ;

-- Ändra utchecknignsdatum
CALL UppdateraBokning('B000005', NULL, NULL, NULL, '2026-10-17 13:00:00', NULL);

-- Ändra priset till 4000 SEK.
